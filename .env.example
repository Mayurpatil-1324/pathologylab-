# Database Connection
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/healthpoint_db?schema=public"

# Authentication & Security
JWT_SECRET="healthpoint-secret-key-32-character-diagnostic-2026-secure"

# Public Brand Details
NEXT_PUBLIC_APP_NAME="HealthPoint Diagnostics"
NEXT_PUBLIC_APP_TAGLINE="Your Health, Our Priority"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="care@healthpointdiagnostics.in"

# Gateway & Service Integrations (Configure in Production)
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT="true"
RAZORPAY_KEY_ID="rzp_test_sample_key"
RAZORPAY_KEY_SECRET="sample_razorpay_secret"

# Notification Provider Config (Twilio / Gupshup / Fast2SMS / Resend)
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
